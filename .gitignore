# --------------------------------------------------
# 環境変数・認証・シークレット情報（最重要：公開禁止）
# --------------------------------------------------
.env
*.env
*.key
*.pem
*.secret
auth.json

# --------------------------------------------------
# Hermes Agent データディレクトリ（data/）
# --------------------------------------------------
# 原則として data 配下の個人データ・会話・ログ・DBはすべて除外
data/*

# ただし、獲得・学習したスキル（skills）のみ Git で共有・管理を許可
!data/skills/
!data/skills/**
!data/.gitkeep

# スキル内に紛れ込んだ一時ファイルやキャッシュは除外
data/skills/**/.env*
data/skills/**/__pycache__/
data/skills/**/*.pyc

# --------------------------------------------------
# 作業スペース・成果物（workspace/）
# --------------------------------------------------
# エージェントが作業中に生成したファイルやDLした一時物は除外
# （永続化したい成果物がある場合は個別に git add -f または別リポジトリで管理）
workspace/*
!workspace/.gitkeep

# --------------------------------------------------
# OS・エディタ・一時ファイル
# --------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
*.swp
*.tmp

# --------------------------------------------------
# セルフホストサービス（外部リポジトリ・クローン物）
# --------------------------------------------------
services/firecrawl/src/

