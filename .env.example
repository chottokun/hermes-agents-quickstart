# --------------------------------------------------
# ホストユーザーの UID / GID 設定
# --------------------------------------------------
# コンテナ内で生成されたファイルがホスト上で root 所有になるのを防ぐため、
# ホスト側の `id -u` および `id -g` の値を指定します（通常は 1000）。
HERMES_UID=1000
HERMES_GID=1000

# --------------------------------------------------
# セルフホスト検索・抽出エンジン設定（data/.env でも設定可能）
# --------------------------------------------------
# SearXNG（ローカルメタ検索エンジン）
SEARXNG_URL=http://localhost:8888

# Firecrawl（ローカルWeb抽出・スクレイピングエンジン）
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=fc-local-key

