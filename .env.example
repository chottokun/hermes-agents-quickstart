# --------------------------------------------------
# ホストユーザーの UID / GID 設定
# --------------------------------------------------
# コンテナ内で生成されたファイルがホスト上で root 所有になるのを防ぐため、
# ホスト側の `id -u` および `id -g` の値を指定します（通常は 1000）。
HERMES_UID=1000
HERMES_GID=1000

# --------------------------------------------------
# Web Dashboard 認証設定
# --------------------------------------------------
# WebUI (http://127.0.0.1:9119) はホストのループバックにのみバインドされます。
# コンテナ内部の non-loopback ガードを満たすため、Basic 認証を設定します。
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=hermes_secure_pass

# --------------------------------------------------
# セルフホスト検索・抽出エンジン設定（data/.env でも設定可能）
# --------------------------------------------------
# SearXNG（内部ネットワーク DNS: http://searxng:8080）
SEARXNG_URL=http://searxng:8080
# SearXNG セッション暗号化キー（本番環境ではランダムな文字列に変更を推奨）
# SEARXNG_SECRET=change_to_random_secret_in_production

# Firecrawl（内部ネットワーク DNS: http://firecrawl:3002）
FIRECRAWL_API_URL=http://firecrawl:3002
FIRECRAWL_API_KEY=fc-local-key
